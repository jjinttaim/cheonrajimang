{"created": "2022-08-02T09:48:44.298963+00:00", "modified": "2022-09-16T11:17:33.300237+00:00", "id": 6592419, "conceptrecid": "6592418", "doi": "10.5281/zenodo.6592419", "conceptdoi": "10.5281/zenodo.6592418", "doi_url": "https://doi.org/10.5281/zenodo.6592419", "metadata": {"title": "First responders' mobile phone traces during a search-and-rescue exercise scenario", "doi": "10.5281/zenodo.6592419", "publication_date": "2022-08-02", "description": "<p>This dataset is collected during a search-and-rescue exercise scenario in the framework of the ARTION project.&nbsp;</p>\n\n<p>The operation took place on the 22nd of May 2022 in Paphos district (near the beach at Mandria village). The exercise was organized and conducted by the Cyprus Civil Defence and data collection was performed by the KIOS Research and Innovation Center of Excellence of the University of Cyprus.&nbsp;</p>\n\n<p>The data&nbsp;is saved in an .xlsx file. It consists of 9 first responders&#39;&nbsp;traces captured during a search-and-rescue operation.&nbsp;The responders were moving on foot holding their mobile phones, which were used for capturing their traces.&nbsp;By means of the ARTION mobile app, the locations of the mobile phones were captured by the build-in GPS receiver of the phone approximately every 5 seconds.&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p>&nbsp;</p>", "access_right": "open", "creators": [{"name": "KIOS Research and Innovation Center of Excellence", "affiliation": "KIOS Research and Innovation Center of Excellence, University of Cyprus"}], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "communities": [{"id": "eu"}, {"id": "disastermanagementai"}, {"id": "kios-coe"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "6592418"}}]}, "notes": "The project has received funding from the European Union's Call for proposals in the field of Civil Protection under the Union Civil Protection Knowledge Network under grant agreement 101017763."}, "title": "First responders' mobile phone traces during a search-and-rescue exercise scenario", "links": {"self": "https://zenodo.org/api/records/6592419", "self_html": "https://zenodo.org/records/6592419", "preview_html": "https://zenodo.org/records/6592419?preview=1", "doi": "https://doi.org/10.5281/zenodo.6592419", "self_doi": "https://doi.org/10.5281/zenodo.6592419", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.6592419", "reserve_doi": "https://zenodo.org/api/records/6592419/draft/pids/doi", "parent": "https://zenodo.org/api/records/6592418", "parent_html": "https://zenodo.org/records/6592418", "parent_doi": "https://doi.org/10.5281/zenodo.6592418", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.6592418", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:6592419/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:6592419/sequence/default", "files": "https://zenodo.org/api/records/6592419/files", "media_files": "https://zenodo.org/api/records/6592419/media-files", "archive": "https://zenodo.org/api/records/6592419/files-archive", "archive_media": "https://zenodo.org/api/records/6592419/media-files-archive", "latest": "https://zenodo.org/api/records/6592419/versions/latest", "latest_html": "https://zenodo.org/records/6592419/latest", "versions": "https://zenodo.org/api/records/6592419/versions", "draft": "https://zenodo.org/api/records/6592419/draft", "access_links": "https://zenodo.org/api/records/6592419/access/links", "access_grants": "https://zenodo.org/api/records/6592419/access/grants", "access_users": "https://zenodo.org/api/records/6592419/access/users", "access_request": "https://zenodo.org/api/records/6592419/access/request", "access": "https://zenodo.org/api/records/6592419/access", "communities": "https://zenodo.org/api/records/6592419/communities", "communities-suggestions": "https://zenodo.org/api/records/6592419/communities-suggestions", "request_deletion": "htt